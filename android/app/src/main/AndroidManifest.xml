<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <!-- localizacao com a tela desligada: exige servico em primeiro plano e o aviso fixo na barra -->
  <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
  <uses-permission android:name="android.permission.WAKE_LOCK"/>
  <!-- O DESPERTADOR QUE RELIGA O RASTREIO (22/10). O alarme precisa ser EXATO nao por
       precisao, e sim por direito: do Android 12 em diante abrir servico em primeiro
       plano vindo do fundo e proibido, e o alarme exato e uma das poucas isencoes.
       SCHEDULE_EXACT_ALARM ja vem concedida na instalacao (Android 12) e USE_EXACT_ALARM
       e automatica do Android 13 em diante. -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
  <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
  <!-- pedir ao proprio Android para nao encerrar este aplicativo (Samsung e Xiaomi) -->
  <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
  <!-- instalar a versao nova de dentro do proprio aplicativo (atualizacao automatica) -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <uses-feature android:name="android.hardware.location.gps" android:required="false"/>
  <!-- para saber se o WhatsApp (Business ou comum) esta instalado e mandar o PDF direto nele (28/10) -->
  <queries>
    <package android:name="com.whatsapp"/>
    <package android:name="com.whatsapp.w4b"/>
  </queries>
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <!-- A CAMERA (28/10): sem esta linha o Android nega a camera ao aplicativo, e a pagina nao
       abre o leitor de codigo de barras nem a foto do Cartao de Ponto ("Nao consegui abrir a camera") -->
  <uses-permission android:name="android.permission.CAMERA"/>

  <application
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:usesCleartextTraffic="false"
      android:allowBackup="false"
      android:theme="@style/Tema">

    <activity android:name=".TelaPrincipal"
        android:exported="true"
        android:configChanges="orientation|screenSize|keyboardHidden|screenLayout|uiMode"
        android:launchMode="singleTask">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>

    <service android:name=".ServicoLocalizacao"
        android:exported="false"
        android:foregroundServiceType="location"/>

    <!-- entrega o arquivo baixado ao instalador do Android -->
    <provider
        android:name="androidx.core.content.FileProvider"
        android:authorities="br.com.minasfiltros.sistema.arquivos"
        android:exported="false"
        android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
          android:resource="@xml/pastas_do_app"/>
    </provider>

    <!-- O QUE RELIGA O RASTREIO SOZINHO. A acao do despertador (VIGIA) NAO entra aqui
         de proposito: ela e disparada por intencao explicita, do proprio aplicativo,
         e fora do filtro ninguem de fora consegue mandar. -->
    <receiver android:name=".AoLigar" android:exported="true">
      <intent-filter>
        <!-- o celular reiniciou, ou a bateria acabou e ele voltou -->
        <action android:name="android.intent.action.BOOT_COMPLETED"/>
        <!-- o boot rapido da Xiaomi/Redmi manda este, e nao o de cima -->
        <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
        <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
        <!-- o aplicativo foi atualizado: a instalacao por cima mata o processo -->
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
      </intent-filter>
    </receiver>
  </application>
</manifest>
